# ─────────────────────────────────────────────────────────────
# Production settings for docker-compose.prod.yml (single VPS).
# Copy to .env.production, fill every REPLACE_ME, keep it out of git (chmod 600).
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────

# Public site
DOMAIN=ncsanthanam.in
ACME_EMAIL=REPLACE_ME@ncsanthanam.in
APP_URL=https://ncsanthanam.in
LOG_LEVEL=info
APP_REPLICAS=2
WORKER_REPLICAS=1

# Database / cache (internal to the Docker network)
POSTGRES_USER=ncs
POSTGRES_DB=ncs
POSTGRES_PASSWORD=REPLACE_ME
DATABASE_POOL_MAX=10
REDIS_PASSWORD=REPLACE_ME

# Auth
BETTER_AUTH_SECRET=REPLACE_ME
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Razorpay (live keys; webhook URL: https://<DOMAIN>/api/webhooks/razorpay,
# events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Object storage — EITHER AWS S3 / Cloudflare R2 …
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=ncs-media
S3_PRIVATE_BUCKET=ncs-private
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://REPLACE_ME.cloudfront.net
# … OR the bundled SeaweedFS (start with --profile selfhosted-storage and use):
# S3_ENDPOINT=http://s3:8333
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://ncsanthanam.in/media/ncs-media

# Email (AWS SES SMTP credentials, domain verified in SES)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM="NCS Santhanam <orders@ncsanthanam.in>"

# SMS (MSG91 with DLT-approved templates; the OTP template must expose an "otp" variable)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=REPLACE_ME
MSG91_SENDER_ID=REPLACE_ME
MSG91_OTP_TEMPLATE_ID=REPLACE_ME
MSG91_ORDER_TEMPLATE_ID=REPLACE_ME

SENTRY_DSN=
