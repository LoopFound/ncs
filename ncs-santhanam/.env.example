# ─────────────────────────────────────────────────────────────
# NCS Santhanam — environment configuration
# Copy to .env for local development. In production, inject these via
# your secret manager (AWS Secrets Manager / docker secrets), never commit them.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Public base URL of the storefront (no trailing slash).
APP_URL=http://localhost:3100
LOG_LEVEL=info

# ── Database (PostgreSQL) ────────────────────────────────────
# In production point this at PgBouncer / RDS Proxy.
DATABASE_URL=postgresql://ncs:ncs@localhost:55432/ncs
# Max connections per app instance (keep total under the DB / pooler limit).
DATABASE_POOL_MAX=10

# ── Redis (cache, rate limiting, job queues) ─────────────────
REDIS_URL=redis://localhost:56379

# ── Auth (Better Auth) ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes
# Optional — enables "Continue with Google" when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins when they sign up (bootstrap only).
ADMIN_EMAILS=

# ── Payments (Razorpay) ──────────────────────────────────────
# Leave empty to disable online payment (COD only). Use rzp_test_ keys in staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Object storage (S3 or any S3-compatible service) ─────────
# For AWS S3 leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:58333
S3_REGION=ap-south-1
# Public bucket (product media) and private bucket (GST invoices — served via signed URLs).
S3_BUCKET=ncs-media
S3_PRIVATE_BUCKET=ncs-private
S3_ACCESS_KEY_ID=ncs-dev-access
S3_SECRET_ACCESS_KEY=ncs-dev-secret-change-me
S3_FORCE_PATH_STYLE=true
# Public base URL objects are served from (CloudFront domain in production).
S3_PUBLIC_URL=http://localhost:58333/ncs-media

# ── Email (SMTP — AWS SES SMTP in production, Mailpit locally) ─
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NCS Santhanam <no-reply@ncsanthanam.in>"

# ── SMS (OTP + order updates) ────────────────────────────────
# "console" logs messages (development). "msg91" sends via MSG91 (requires DLT templates).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_ORDER_TEMPLATE_ID=

# ── Observability ────────────────────────────────────────────
# Optional error reporting endpoint (Sentry-compatible DSN).
SENTRY_DSN=
