// NCS Santhanam — database schema.
// Conventions: all money is integer paise (₹1 = 100). GST rates are basis points (5% = 500).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth (shape required by Better Auth + phoneNumber/admin plugins)
// ─────────────────────────────────────────────────────────────

model User {
  id                  String    @id
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean?  @default(false)
  role                String    @default("user") // user | staff | admin
  banned              Boolean?  @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  redemptions   CouponRedemption[]
  auditLogs     AuditLog[]
  contactMsgs   ContactMessage[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@map("wishlist_items")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String
  path           String     @unique // e.g. "kanchipuram/traditional"
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  description    String?
  image          String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  showInNav      Boolean    @default(true)
  hsnCode        String     @default("5007")
  gstRateBps     Int        @default(500)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  subtitle       String?
  description    String
  story          String?
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status         ProductStatus    @default(DRAFT)
  collection     String?
  fabric         String?
  weave          String?
  zari           String?
  occasion       String?
  care           String?
  colorName      String?
  colorHex       String?
  craftTime      String?
  details        String[]         @default([])
  motifs         String[]         @default([])
  tags           String[]         @default([])
  isFeatured     Boolean          @default(false)
  isSignature    Boolean          @default(false) // appears in the homepage drape carousel
  isNewArrival   Boolean          @default(false)
  sortRank       Int              @default(0)
  hsnCode        String? // overrides category
  gstRateBps     Int? // overrides category
  seoTitle       String?
  seoDescription String?
  images         ProductImage[]
  variants       ProductVariant[]
  reviews        Review[]
  wishlistedBy   WishlistItem[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, isSignature])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  storageKey String?
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
  @@map("product_images")
}

enum StockUnit {
  PIECE
  METRE
}

model ProductVariant {
  id                String              @id @default(cuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String              @unique
  title             String              @default("Default")
  price             Int // paise, GST inclusive
  compareAtPrice    Int?
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(2)
  unit              StockUnit           @default(PIECE)
  maxPerOrder       Int                 @default(10)
  weightGrams       Int                 @default(900)
  isActive          Boolean             @default(true)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  movements         InventoryMovement[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([productId])
  @@map("product_variants")
}

enum InventoryReason {
  RESTOCK
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  ORDER_RETURNED
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    InventoryReason
  orderId   String?
  actorId   String?
  note      String?
  createdAt DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────
// Cart
// ─────────────────────────────────────────────────────────────

model Cart {
  id          String     @id @default(cuid())
  userId      String?    @unique
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousId String?    @unique // value of the httpOnly cart cookie for signed-out shoppers
  couponCode  String?
  items       CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────
// Orders, payments, shipping
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id              String               @id @default(cuid())
  number          String               @unique
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus          @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus        @default(PENDING)
  currency        String               @default("INR")
  subtotal        Int // sum of GST-inclusive line totals
  discountTotal   Int                  @default(0)
  shippingTotal   Int                  @default(0)
  codFee          Int                  @default(0)
  taxTotal        Int // GST contained in the grand total
  grandTotal      Int
  couponCode      String?
  email           String
  phone           String
  shippingAddress Json
  addFallPico     Boolean              @default(false)
  giftWrap        Boolean              @default(false)
  giftMessage     String?
  customerNote    String?
  expiresAt       DateTime?
  placedAt        DateTime             @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  invoiceNumber   String?              @unique
  invoiceKey      String?
  items           OrderItem[]
  history         OrderStatusHistory[]
  payments        Payment[]
  shipment        Shipment?
  redemption      CouponRedemption?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  image       String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  hsnCode     String
  gstRateBps  Int
  taxAmount   Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "razorpay" | "cod"
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  method            String?
  errorReason       String?
  refunds           Refund[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerRefundId String?  @unique
  amount           Int
  status           String // pending | processed | failed
  reason           String?
  actorId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([paymentId])
  @@map("refunds")
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier     String
  awb         String
  trackingUrl String?
  shippedAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@map("shipments")
}

model ShippingRule {
  id               String   @id @default(cuid())
  name             String
  // PIN code prefixes this rule covers; empty = fallback rule for all of India.
  pincodePrefixes  String[] @default([])
  rate             Int      @default(0)
  freeAbove        Int?
  codAvailable     Boolean  @default(true)
  codFee           Int      @default(0)
  codMaxOrderValue Int      @default(5000000)
  etaMinDays       Int      @default(3)
  etaMaxDays       Int      @default(6)
  priority         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("shipping_rules")
}

// ─────────────────────────────────────────────────────────────
// Promotions & reviews
// ─────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  description   String?
  type          CouponType
  value         Int // PERCENT: basis points, FIXED: paise
  minOrderValue Int                @default(0)
  maxDiscount   Int?
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  perUserLimit  Int                @default(1)
  usedCount     Int                @default(0)
  isActive      Boolean            @default(true)
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// Content & operations
// ─────────────────────────────────────────────────────────────

enum BannerPlacement {
  HERO
  PROMO
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement
  tag       String?
  title     String
  subtitle  String?
  image     String
  href      String?
  ctaLabel  String?
  accent    String?
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

model StoreSettings {
  id                String   @id @default("default")
  storeName         String   @default("NCS Santhanam")
  legalName         String   @default("NCS Santhanam Silks")
  gstin             String?
  phone             String?
  whatsapp          String?
  supportEmail      String?
  privacyEmail      String?
  addressLine       String   @default("59, Viladadikoil Street")
  city              String   @default("Kancheepuram")
  state             String   @default("Tamil Nadu")
  pincode           String   @default("631501")
  hours             String   @default("Mon – Sat: 10:00 AM – 8:00 PM | Sun: 10:00 AM – 2:00 PM")
  codEnabled        Boolean  @default(true)
  orderHoldMinutes  Int      @default(30)
  updatedAt         DateTime @updatedAt

  @@map("store_settings")
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  status      SubscriberStatus @default(PENDING)
  token       String           @unique
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("newsletter_subscribers")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

model WebhookEvent {
  id          String    @id // provider's event id (x-razorpay-event-id)
  provider    String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
