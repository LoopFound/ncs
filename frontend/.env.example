# Copy to .env.local for local development.

# Base URL of the backend app (the Next.js app in ../backend). The storefront proxies
# every /api/* request to it, so the browser only ever talks to the storefront origin.
# REQUIRED in Vercel (Project Settings > Environment Variables), e.g. https://admin.ncsanthanam.in
# Defaults to http://localhost:3000 when unset. The backend must list this storefront's
# origin in its STOREFRONT_URL env so Better Auth and the CSRF guard accept its requests.
BACKEND_URL=http://localhost:3000

# Public canonical URL of the storefront (used for metadata, robots and sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Shared secret (>= 32 chars), same value as the backend's STOREFRONT_PROXY_SECRET. src/proxy.ts sends it with
# the shopper's IP so backend rate limits are per customer, not per Vercel IP. Server-only: never NEXT_PUBLIC_.
# Leave empty in local dev (the backend then falls back to X-Forwarded-For).
STOREFRONT_PROXY_SECRET=
